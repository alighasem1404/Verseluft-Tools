{
  "title": "NPC Family Maker Race Age Ranges",
  "schemaVersion": "1.0.0",
  "description": "Race age limits and life-stage boundaries used by the NPC Family Maker. Ages are in years.",
  "source": {
    "workbook": "New Population Maker",
    "sourceFile": "Data/npc-family-maker-data.js",
    "note": "The 2024 Basic Rules say most species live about 80 years and reach physical maturity at about the same age, but do not give separate numerical adulthood ages for Orcs or Goliaths. The app therefore uses the Human maturity convention for them: young adult at 14, adult at 18, maximum age 80. Satyr, Raven, Hyena, and Celestial use the same human-like custom-race convention in this app. For Centaur and Deer-folk, the app uses maximum age 100 and adulthood at 18."
  },
  "rules": {
    "lifeStageClassification": "child is below youngAdulthood; youngAdult is from youngAdulthood through adulthood minus 1; adult is adulthood and older.",
    "generatedAdultAge": "The app generates ordinary adults from adulthood through floor(maxAge * 0.72).",
    "generatedElderAge": "The app generates elders from max(adulthood + 25, floor(maxAge * 0.45)) through maxAge.",
    "childAgeNote": "Child generation also considers the parent age, so a child does not always use the entire theoretical child interval."
  },
